<resources>

    <!-- Same as values-v31, plus a text style for Android 15+. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="android:textViewStyle">@style/AppTextView</item>
    </style>

    <!--
      Android 15 lays text out by glyph bounds for apps targeting it, while React Native
      measures by glyph advances. For Hindi and Bengali the bounds are wider, so labels were
      measured too narrow and their last word was cut off. Lay out by advances, like RN.
    -->
    <style name="AppTextView" parent="android:Widget.TextView">
        <item name="android:useBoundsForWidth">false</item>
    </style>

</resources>
